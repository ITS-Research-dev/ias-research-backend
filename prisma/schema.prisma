datasource db {
  provider = "postgresql" // Sesuaikan provider database Anda (postgresql, mysql, sqlite, dll.)
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleState {
  GURU
  SISWA
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  description String @db.VarChar
  users       User[]

  @@map("TABLE_ROLE")
}

model Class {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar
  waliKelas   String        @db.VarChar
  countTotal  Int
  assignments ClassAssign[]
  topics      Topic[]

  @@map("TABLE_CLASS")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  idRole       String @db.Uuid
  fullName     String @db.VarChar
  uCredentials String @db.VarChar
  uPassword    String @db.VarChar

  role             Role          @relation(fields: [idRole], references: [id])
  assignments      ClassAssign[]
  scores           Score[]       @relation("UserScores")
  overriddenScores Score[]       @relation("TeacherOverrides")
  progresses       Progress[]

  @@map("TABLE_USER")
}

model ClassAssign {
  id      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idUser  String    @db.Uuid
  idClass String    @db.Uuid
  state   RoleState

  user  User  @relation(fields: [idUser], references: [id])
  class Class @relation(fields: [idClass], references: [id])

  @@map("TABLE_CLASS_ASSIGN")
}

model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  idClass     String   @db.Uuid
  title       String   @db.VarChar
  subject     String   @db.Text
  description String   @default("ini deskripsi")
  startDate   DateTime @default(now())
  isActive    Boolean

  class      Class      @relation(fields: [idClass], references: [id])
  tests      Test[]
  progresses Progress[]

  @@map("TABLE_TOPIC")
}

model Test {
  id        String @id @default(uuid()) @db.Uuid
  idTopic   String @db.Uuid
  title     String @db.VarChar
  question  String @db.Text
  expOutput String @db.VarChar
  maxTries  Int

  topic  Topic   @relation(fields: [idTopic], references: [id])
  hints  Hint[]
  scores Score[]

  @@map("TABLE_TEST")
}

model Hint {
  id     String @id @default(uuid()) @db.Uuid
  idTest String @db.Uuid
  hint1  String @db.Text
  hint2  String @db.Text
  hint3  String @db.Text

  test Test @relation(fields: [idTest], references: [id])

  @@map("TABLE_HINT")
}

model Score {
  id                String   @id @default(uuid()) @db.Uuid
  idTest            String   @db.Uuid
  idUser            String   @db.Uuid
  level             String   @db.VarChar
  averageScore      Int
  flagOverride      Boolean
  hintUsage         Int      @default(0)
  aiScore           String   @db.Text
  aiSuggestion      String   @db.Text
  aiFinishTime      DateTime @db.Time
  uCode             String   @db.Text
  overrideBy        String?  @db.Uuid
  teacherScore      String?  @db.Text
  teacherSuggestion String?  @db.Text
  createdAt         DateTime @default(now())

  test           Test  @relation(fields: [idTest], references: [id])
  user           User  @relation("UserScores", fields: [idUser], references: [id])
  overridingUser User? @relation("TeacherOverrides", fields: [overrideBy], references: [id])

  @@map("TABLE_SCORE")
}

model Progress {
  idUser        String @db.Uuid
  idTopic       String @db.Uuid
  maxCount      Int
  progressCount Int

  user  User  @relation(fields: [idUser], references: [id])
  topic Topic @relation(fields: [idTopic], references: [id])

  @@id([idUser, idTopic])
  @@map("TABLE_PROGRESS")
}
