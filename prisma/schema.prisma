generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////////////
// ROLE
/////////////////////////////////////////////////////////

model Role {
  id          String @id @default(uuid()) @db.Uuid
  description String

  users User[]

  @@map("table_role")
}

/////////////////////////////////////////////////////////
// CLASS
/////////////////////////////////////////////////////////

model Class {
  id         String @id @default(uuid()) @db.Uuid
  title      String
  waliKelas  String
  countTotal Int

  users User[]
  tests Test[]

  @@map("table_class")
}

/////////////////////////////////////////////////////////
// USER
/////////////////////////////////////////////////////////

model User {
  id           String @id @default(uuid()) @db.Uuid

  idRole       String @db.Uuid
  idClass      String? @db.Uuid

  uCredentials String @unique
  uPassword    String

  role         Role  @relation(fields: [idRole], references: [id])

  class        Class? @relation(fields: [idClass], references: [id])

  progresses   Progress[]
  scores       Score[]
  overrides    Score[] @relation("ScoreOverride")

  @@map("table_user")
}

/////////////////////////////////////////////////////////
// TOPIC
/////////////////////////////////////////////////////////

model Topic {
  id      String @id @default(uuid()) @db.Uuid
  title   String
  text    String
  orderNo Int
  status  Boolean

  tests      Test[]
  progresses Progress[]

  @@map("table_topic")
}

/////////////////////////////////////////////////////////
// TEST
/////////////////////////////////////////////////////////

model Test {
  id         String @id @default(uuid()) @db.Uuid

  idClass    String @db.Uuid
  idTopic    String @db.Uuid
  idRubric   String? @db.Uuid

  title      String
  expOutput  String
  maxTries   Int

  class       Class @relation(fields: [idClass], references: [id])
  topic       Topic @relation(fields: [idTopic], references: [id])

  hints        Hint[]
  scores       Score[]

  @@map("table_test")
}

/////////////////////////////////////////////////////////
// HINT
/////////////////////////////////////////////////////////

model Hint {
  id         String @id @default(uuid()) @db.Uuid

  idQuestion String @db.Uuid

  hint2      String
  hint3      String

  question   Test @relation(fields: [idQuestion], references: [id])

  @@map("table_hint")
}

/////////////////////////////////////////////////////////
// SCORE
/////////////////////////////////////////////////////////

model Score {
  id                 String @id @default(uuid()) @db.Uuid

  idUser             String @db.Uuid
  idTest             String @db.Uuid

  level              String
  flagOverride       Boolean

  aiScore            String
  aiSuggestion       String
  aiFinishTime       String

  uCode              String

  overrideBy         String? @db.Uuid

  teacherScore       String?
  teacherSuggestion  String?

  createdAt          DateTime @default(now())

  user User @relation(fields: [idUser], references: [id])

  test Test @relation(fields: [idTest], references: [id])

  teacher User? @relation(
    "ScoreOverride",
    fields: [overrideBy],
    references: [id]
  )

  @@map("table_score")
}

/////////////////////////////////////////////////////////
// PROGRESS
/////////////////////////////////////////////////////////

model Progress {
  id       String @id @default(uuid()) @db.Uuid

  idUser   String @db.Uuid
  idTopic  String @db.Uuid

  progress Int

  user User @relation(fields: [idUser], references: [id])

  topic Topic @relation(fields: [idTopic], references: [id])

  @@unique([idUser, idTopic])

  @@map("table_progress")
}